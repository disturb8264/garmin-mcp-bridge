# Garmin account and PostgreSQL credentials. Keep this file private at
# runtime/garmin/.env; Docker Compose passes it only to the Garmin container.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=../../runtime/garmin/data/tokens
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
MCP_PGUSER=
MCP_PGPASSWORD=
SYNC_LOOKBACK_DAYS=7
LOG_LEVEL=INFO
TZ=Asia/Seoul
