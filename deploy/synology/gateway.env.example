# Gateway container environment for Synology Container Manager.
# Enter every key below in the container's Environment settings.
TUNNEL_ID=
CONTROL_PLANE_API_KEY=
TZ=Asia/Seoul

# Runtime paths and tunnel connection inside the container.
GATEWAY_CONFIG=/app/gateway.yaml
MCP_SERVER_URL=http://127.0.0.1:18767/mcp
MCP_EXTRA_HEADERS=X-MCP-Internal-Token: file:/app/secrets/gateway_token
MCP_DISCOVERY_EXTRA_HEADERS=X-MCP-Internal-Token: file:/app/secrets/gateway_token
