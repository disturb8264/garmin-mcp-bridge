# Garmin container environment for Synology Container Manager.
# Enter every key below in the container's Environment settings.
# Replace blank values with the real account and PostgreSQL credentials.
GARMIN_EMAIL=
GARMIN_PASSWORD=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
MCP_PGUSER=
MCP_PGPASSWORD=
SYNC_LOOKBACK_DAYS=7
LOG_LEVEL=INFO
TZ=Asia/Seoul

# Runtime paths and ports inside the container; keep these values with the mounts below.
GARMIN_TOKEN_DIR=/app/data/tokens
COLLECTOR_TOKEN_FILE=/run/secrets/collector_internal_token
COLLECTOR_API_HOST=127.0.0.1
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_TOKEN_FILE=/run/secrets/mcp_internal_token
MCP_COLLECTOR_URL=http://127.0.0.1:8766/collect-range
MCP_COLLECTOR_TOKEN_FILE=/run/secrets/collector_internal_token
