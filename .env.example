# Garmin Connect account. Fill these before the first login.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=./data/tokens

# Existing PostgreSQL server. Not needed for --dry-run.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Recheck this many recent days during --mode sync.
SYNC_LOOKBACK_DAYS=7
LOG_LEVEL=INFO
TZ=Asia/Seoul

# MCP query service. Use a dedicated PostgreSQL read-only role.
MCP_PGUSER=
MCP_PGPASSWORD=
MCP_PORT=8765
# Optional: use a separately published GHCR image instead of the Docker Hub image.
# GARMIN_IMAGE=ghcr.io/disturb8264/garmin-mcp-bridge:0.2.0
# On Synology, set these to the UID/GID that owns data/tokens and data/mcp_internal_token.
PUID=1000
PGID=1000

# OpenAI Secure MCP Tunnel. The runtime key needs Tunnels Read + Use.
TUNNEL_ID=
CONTROL_PLANE_API_KEY=
