# Compose settings only. Put Garmin and gateway credentials in runtime/garmin/.env
# and runtime/gateway/.env respectively.
GARMIN_IMAGE=disturb8264/garmin-mcp:0.4.0
GATEWAY_IMAGE=disturb8264/mcp-gateway:0.4.1
# host: same-host upstreams using 127.0.0.1; bridge: remote upstreams.
GATEWAY_NETWORK_MODE=host
PUID=1000
PGID=1000
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=18765
TZ=Asia/Seoul
